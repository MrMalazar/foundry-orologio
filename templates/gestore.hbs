<div class="orologio-gestore">
  <div class="orologio-barra">
    <button type="button" data-action="nuovo"><i class="fa-solid fa-plus"></i> {{localize "OROLOGIO.Gestore.Nuovo"}}</button>
  </div>
  {{#unless orologi.length}}
  <p class="orologio-vuoto">{{localize "OROLOGIO.Gestore.Vuoto"}}</p>
  {{/unless}}
  {{#each orologi}}
  <div class="orologio-riga stato-{{stato}}" data-id="{{id}}">
    <div class="orologio-torta-box">{{{svg}}}</div>
    <div class="orologio-info">
      <div class="orologio-titolo">
        {{titolo}}
        {{#unless visibile}}<i class="fa-solid fa-eye-slash" title="{{localize "OROLOGIO.Pannello.NascostoAiGiocatori"}}"></i>{{/unless}}
      </div>
      <div class="orologio-dettagli">
        {{pieni}}/{{segmenti}} · {{#if senzaTimer}}{{localize "OROLOGIO.Gestore.AMano"}}{{else}}{{durataTesto}} {{localize "OROLOGIO.Gestore.PerSegmento"}}{{/if}} · {{statoEtichetta}}{{#if ciclo}} · {{localize "OROLOGIO.Campi.Ciclo"}}{{/if}}
      </div>
      {{#if corrente}}<div class="orologio-segmento">{{corrente}}</div>{{/if}}
      {{#unless senzaTimer}}<div class="orologio-tempo {{stato}}">{{tempo}}</div>{{/unless}}
    </div>
    <div class="orologio-comandi griglia">
      <button type="button" data-action="comando" data-azione="indietro" title="{{localize "OROLOGIO.Comandi.Indietro"}}" {{#if bloccato}}disabled{{/if}}><i class="fa-solid fa-backward-step"></i></button>
      {{#unless senzaTimer}}<button type="button" data-action="comando" data-azione="playPausa" title="{{#if inCorso}}{{localize "OROLOGIO.Comandi.Pausa"}}{{else}}{{localize "OROLOGIO.Comandi.Avvia"}}{{/if}}" {{#if bloccato}}disabled{{/if}}><i class="fa-solid {{#if inCorso}}fa-pause{{else}}fa-play{{/if}}"></i></button>{{/unless}}
      <button type="button" data-action="comando" data-azione="avanti" title="{{localize "OROLOGIO.Comandi.Avanti"}}" {{#if bloccato}}disabled{{/if}}><i class="fa-solid fa-forward-step"></i></button>
      <button type="button" data-action="comando" data-azione="blocca" class="{{#if bloccato}}attivo{{/if}}" title="{{#if bloccato}}{{localize "OROLOGIO.Comandi.Sblocca"}}{{else}}{{localize "OROLOGIO.Comandi.Blocca"}}{{/if}}"><i class="fa-solid {{#if bloccato}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
      <button type="button" data-action="comando" data-azione="azzera" title="{{localize "OROLOGIO.Comandi.Azzera"}}" {{#if bloccato}}disabled{{/if}}><i class="fa-solid fa-rotate-left"></i></button>
      <button type="button" data-action="comando" data-azione="visibile" title="{{#if visibile}}{{localize "OROLOGIO.Comandi.Nascondi"}}{{else}}{{localize "OROLOGIO.Comandi.Mostra"}}{{/if}}"><i class="fa-solid {{#if visibile}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></button>
      <button type="button" data-action="modifica" title="{{localize "OROLOGIO.Comandi.Modifica"}}"><i class="fa-solid fa-pen"></i></button>
      <button type="button" data-action="elimina" class="pericolo" title="{{localize "OROLOGIO.Comandi.Elimina"}}"><i class="fa-solid fa-trash"></i></button>
    </div>
  </div>
  {{/each}}
</div>
